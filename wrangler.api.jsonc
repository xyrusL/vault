{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatgpt-accounts-api",
  "main": "worker/api.js",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.vault.deze.me",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://vault.deze.me,https://www.vault.deze.me",
    "EMAIL_DOMAINS": "tpmail.deze.me,octagram.qzz.io",
    "EMAIL_ROUTING_ZONES": "tpmail.deze.me=60be8001944d6c2354d8ccedc81bf06a,octagram.qzz.io=a8972358f3510337c411f40e7030b1fb",
    "EMAIL_ROUTING_WORKER": "vault-email-worker",
    "CLOUDFLARE_ACCOUNT_ID": "4002cabf9107796667c42a5eed175298"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vault-db",
      "database_id": "deddf748-bf00-423f-ba2c-a4ef0a62a7da",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
